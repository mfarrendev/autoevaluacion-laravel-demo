APP_NAME="Autoevaluación"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL 8.4 del docker-compose.yml (puerto 33060 para no chocar con un MySQL local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33060
DB_DATABASE=autoevaluacion
DB_USERNAME=app
DB_PASSWORD=secret

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
